#!/bin/sh
# Stamps the site's files with their content hashes before every commit (see scripts/stamp.mjs).
# Enabled in a clone with:  git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"
node scripts/stamp.mjs
git add index.html tree/index.html more/index.html sw.js data/version.js
